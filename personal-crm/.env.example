# Only local synthetic credentials; never commit .env.
CRM_DB_PASSWORD=
# In Compose use host crm-db, database personal_crm and user crm.
# URL-encode reserved characters in the password.
CRM_DATABASE_URL=
# Required for protected HTTP endpoints; not a Telegram ID.
CRM_OWNER_ID=
CRM_OWNER_TOKEN=
# Separate credential for the fake-mail connector.
CRM_FAKE_MAIL_TOKEN=
# IMAP remains disconnected until BOTH flags are explicitly enabled for a chosen mailbox.
CRM_MAIL_ENABLED=false
CRM_MAIL_READ_CONSENT=false
CRM_MAIL_IMAP_HOST=
CRM_MAIL_IMAP_PORT=993
CRM_MAIL_USERNAME=
CRM_MAIL_PASSWORD=
# Exact Sent folder name, including its provider prefix; never guess it.
CRM_MAIL_SENT_FOLDER=
# Explicit IANA timezone. Empty means no automatic calendar notifications.
CRM_TIMEZONE=
CRM_DB_PORT=55433
CRM_API_PORT=8001
# Optional adapters are disabled. Never use the existing bot's token or discovered keys.
CRM_OPENAI_ENABLED=false
OPENAI_API_KEY=
CRM_OPENAI_MODEL=
CRM_OPENAI_ALLOWED_MODELS=
# Explicit categories: owner,forward,mail,tasks,dialog. Empty grants no consent.
CRM_AI_CONSENT_CATEGORIES=
CRM_OPENAI_MONTHLY_BUDGET_USD=0
# JSON per model: currency,source,valid_until,input_per_million,output_per_million,input_token_ceiling.
CRM_OPENAI_PRICES_JSON=
CRM_OPENAI_MAX_OUTPUT_TOKENS=512
CRM_OPENAI_MAX_INPUT_CHARS=8000
CRM_OPENAI_TIMEOUT_SECONDS=8
CRM_TELEGRAM_WEBHOOK_ENABLED=false
CRM_TELEGRAM_SEND_ENABLED=false
CRM_TELEGRAM_WEBHOOK_SECRET=
CRM_TELEGRAM_TEST_TOKEN=
CRM_TELEGRAM_BOT_ID=
CRM_TELEGRAM_ALLOWED_USER_IDS=
CRM_TELEGRAM_ALLOWED_CHAT_IDS=
CRM_TELEGRAM_OUTBOUND_CHAT_ID=
CRM_TELEGRAM_ALLOW_GROUPS=false
