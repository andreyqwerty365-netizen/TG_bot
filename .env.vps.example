BOT_TOKEN=replace_with_rotated_token
# Leave empty for public access; provide comma-separated Telegram user IDs to restrict access.
BOT_ALLOWED_USER_IDS=
BOT_DEFAULT_TZ_MINUTES=180
BOT_LOG_LEVEL=INFO
BOT_LOG_MAX_BYTES=5242880
BOT_LOG_BACKUP_COUNT=5
BOT_TRAINER_DB_PATH=/data/workouts.sqlite3
BOT_EXERCISES_PATH=/app/exercises.json
BOT_TRAINER_TIMEZONE=Europe/Moscow
